#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/* Uncomment this block if using RGB
&led_strip {
    chain-length = <6>;
    // chain-length = <35>; // Uncomment if using both per-key and underglow LEDs
    // chain-length = <29>; // Uncomment if using only per-key LEDs.
};
 */

#define DEFAULT 0
#define INTERFACE 1
#define GAME   2
#define MAC 3

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESCAPE        &kp N1          &kp N2          &kp N3           &kp N4     &kp N5     &kp UP_ARROW     &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp BACKSPACE
&kp TAB           &kp Q           &kp UP_ARROW    &kp E            &kp R      &kp T      &kp DOWN_ARROW   &kp Y   &kp U   &kp I      &kp O     &kp P     &kp BACKSLASH
&kp CAPSLOCK      &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp F      &kp G      &kp LEFT_ARROW   &kp H   &kp J   &kp K      &kp L     &kp SEMI  &kp ENTER
&kp LEFT_CONTROL  &bt BT_CLR      &kp X           &kp C            &kp V      &kp B      &kp RIGHT_ARROW  &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHIFT
&kp C_MUTE        &kp LCTRL       &kp LALT        &kp LEFT_GUI     &kp SPACE  &kp TAB    &kp ENTER        &mo 1   &mo 2   &kp MINUS  &kp LBKT  &kp RBKT
            >;

            sensor-bindings = <&inc_dec_kp K_SCROLL_UP K_SCROLL_DOWN>;
        };

        interface_layer {
            bindings = <
&kp A    &kp ESC   &kp F1    &kp F2    &kp F3     &kp F4       &kp F5     &kp F6       &kp F7     &kp F8          &kp F9        &kp F10          &kp F11
&kp F12  &kp F10   &kp F10   &kp F10   &kp PG_UP  &kp PG_DN    &kp DEL    &kp HOME     &kp GRAVE  &kp N1          &kp N2        &kp N3           &kp N4
&kp N5   &kp N6    &kp N7    &kp N8    &kp N9     &kp N0       &kp MINUS  &kp EQUAL    &kp BSPC   &kp KP_NUMLOCK  &kp KP_SLASH  &kp KP_ASTERISK  &kp KP_MINUS
&trans   &kp END   &kp TAB   &kp Q     &kp W      &kp E        &kp R      &kp T        &trans     &kp Y           &kp U         &kp I            &kp O
&kp P    &kp LBKT  &kp RBKT  &kp BSLH  &kp N7     &kp N8       &kp N9     &kp KP_PLUS  &kp PG_UP  &kp CAPS        &kp A         &kp S
            >;
        };

        game_layer {
            bindings = <
&kp B    &kp ESC   &kp F1    &kp F2    &kp F3     &kp F4       &kp F5     &kp F6       &kp F7     &kp F8          &kp F9        &kp F10          &kp F11
&kp F12  &kp F10   &kp F10   &kp F10   &kp PG_UP  &kp PG_DN    &kp DEL    &kp HOME     &kp GRAVE  &kp N1          &kp N2        &kp N3           &kp N4
&kp N5   &kp N6    &kp N7    &kp N8    &kp N9     &kp N0       &kp MINUS  &kp EQUAL    &kp BSPC   &kp KP_NUMLOCK  &kp KP_SLASH  &kp KP_ASTERISK  &kp KP_MINUS
&trans   &kp END   &kp TAB   &kp Q     &kp W      &kp E        &kp R      &kp T        &trans     &kp Y           &kp U         &kp I            &kp O
&kp P    &kp LBKT  &kp RBKT  &kp BSLH  &kp N7     &kp N8       &kp N9     &kp KP_PLUS  &kp PG_UP  &kp CAPS        &kp A         &kp S
            >;
        };

        mac_layer {
            bindings = <
&kp C    &kp ESC   &kp F1    &kp F2    &kp F3     &kp F4       &kp F5     &kp F6       &kp F7     &kp F8          &kp F9        &kp F10          &kp F11
&kp F12  &kp F10   &kp F10   &kp F10   &kp PG_UP  &kp PG_DN    &kp DEL    &kp HOME     &kp GRAVE  &kp N1          &kp N2        &kp N3           &kp N4
&kp N5   &kp N6    &kp N7    &kp N8    &kp N9     &kp N0       &kp MINUS  &kp EQUAL    &kp BSPC   &kp KP_NUMLOCK  &kp KP_SLASH  &kp KP_ASTERISK  &kp KP_MINUS
&trans   &kp END   &kp TAB   &kp Q     &kp W      &kp E        &kp R      &kp T        &trans     &kp Y           &kp U         &kp I            &kp O
&kp P    &kp LBKT  &kp RBKT  &kp BSLH  &kp N7     &kp N8       &kp N9     &kp KP_PLUS  &kp PG_UP  &kp CAPS        &kp A         &kp S
            >;
        };
    };
};
